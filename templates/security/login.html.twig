{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px; margin-top: 3rem;">
    <div style="background: #1e293b; padding: 2rem; border-radius: 0.5rem;">
        <h1 style="text-align: center; margin-bottom: 2rem;"> Connexion</h1>

        {% if error %}
            <div style="background: #991b1b; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div style="margin-bottom: 1rem;">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </div>
        {% endif %}

        <form method="post">
            <div style="margin-bottom: 1rem;">
                <label for="inputEmail" style="display: block; margin-bottom: 0.5rem;">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" 
                       style="width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; border-radius: 0.5rem; color: #e2e8f0;" 
                       autocomplete="email" required autofocus>
            </div>

            <div style="margin-bottom: 1rem;">
                <label for="inputPassword" style="display: block; margin-bottom: 0.5rem;">Mot de passe</label>
                <input type="password" name="_password" id="inputPassword" 
                       style="width: 100%; padding: 0.75rem; background: #0f172a; border: 1px solid #334155; border-radius: 0.5rem; color: #e2e8f0;" 
                       autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn" style="width: 100%; margin-top: 1rem;">
                Se connecter
            </button>
        </form>

        <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #334155; color: #94a3b8; font-size: 0.9rem;">
            <p><strong>Comptes de test :</strong></p>
            <p>👤 User : user@cinescope.fr / user123</p>
            <p> Admin : admin@cinescope.fr / admin123</p>
        </div>
    </div>
</div>
{% endblock %}