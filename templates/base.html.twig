<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CinéScope{% endblock %}</title>
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎬</text></svg>">
    {% block stylesheets %}
    <style>
        /* ... ton CSS existant ... */
    </style>
    {% endblock %}
</head>

<body>
    <nav>
        <div class="container">
            <a href="{{ path('app_home') }}" class="logo">🎬 CinéScope</a>
            <ul>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('app_films') }}">Films</a></li>
                <li><a href="{{ path('app_platformes') }}">Plateformes</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_admin_film_index') }}">Admin</a></li>
                {% endif %}
                {% if app.user %}
                    <li><a href="{{ path('app_logout') }}">Déconnexion ({{ app.user.email }})</a></li>
                {% else %}
                    <li><a href="{{ path('app_login') }}">Connexion</a></li>
                {% endif %}
            </ul>
        </div>
    </nav>

    {% block body %}{% endblock %}
</body>

</html>
