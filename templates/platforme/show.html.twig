{% extends 'base.html.twig' %}

{% block title %}{{ platforme.name }} - CinéScope{% endblock %}

{% block body %}
<div class="container">
    <h1>{{ platforme.name }}</h1>

    {% if platforme.logo %}
        <img src="{{ platforme.logo }}" alt="{{ platforme.name }}" style="width:100px; height:auto; object-fit:contain; margin-bottom:1rem;">
    {% endif %}

    <p><strong>URL :</strong> 
        {% if platforme.url %}
            <a href="{{ platforme.url }}" target="_blank">{{ platforme.url }}</a>
        {% else %}
            Non disponible
        {% endif %}
    </p>

    <p><strong>Nombre de films :</strong> {{ platforme.films|length }}</p>

    {% if platforme.films|length > 0 %}
        <h2>Films disponibles :</h2>
        <ul>
            {% for film in platforme.films %}
                <li>
                    <a href="{{ path('app_film_show', {'id': film.id}) }}">
                        {{ film.title }} ({{ film.releaseYear }})
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <a href="{{ path('app_platformes') }}" class="btn" style="margin-top:1rem;">Retour aux plateformes</a>
</div>
{% endblock %}
