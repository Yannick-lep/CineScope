{% extends 'base.html.twig' %}

{% block title %}Films - CinéScope{% endblock %}

{% block body %}
<div class="container">
    <h1 style="font-size: 2.5rem; margin-bottom: 2rem;">🎬 Catalogue de films</h1>

    {# Barre de recherche et filtres #}
    <form method="get" style="margin-bottom: 2rem;">
        <div style="display: grid; gap: 1rem; grid-template-columns: 1fr auto auto auto;">
            <input 
                type="text" 
                name="search" 
                placeholder="Rechercher un film..." 
                value="{{ search }}"
                style="padding: 0.75rem 1rem; background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 0.5rem; color: #e2e8f0;"
            >
            
            <select name="year" style="padding: 0.75rem 1rem; background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 0.5rem; color: #e2e8f0;">
                <option value="">Toutes les années</option>
                {% for y in years %}
                    <option value="{{ y }}" {% if selectedYear == y %}selected{% endif %}>{{ y }}</option>
                {% endfor %}
            </select>
            
            <select name="platforme" style="padding: 0.75rem 1rem; background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 0.5rem; color: #e2e8f0;">
                <option value="">Toutes les plateformes</option>
                {% for platforme in platformes %}
                    <option value="{{ platforme.id }}" {% if selectedPlatforme == platforme.id %}selected{% endif %}>{{ platforme.name }}</option>
                {% endfor %}
            </select>
            
            <div style="display: flex; gap: 0.5rem;">
                <button type="submit" class="btn">🔍 Filtrer</button>
                {% if search or selectedYear or selectedPlatforme %}
                    <a href="{{ path('app_films') }}" class="btn" style="background: rgba(148, 163, 184, 0.2);">✕</a>
                {% endif %}
            </div>
        </div>
    </form>

    {% if search or selectedYear or selectedPlatforme %}
        <p style="color: #94a3b8; margin-bottom: 1rem;">
            {{ pagination.getTotalItemCount }} film(s) trouvé(s)
            {% if search %} pour "<strong style="color: #38bdf8;">{{ search }}</strong>"{% endif %}
        </p>
    {% endif %}

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
        {% for film in pagination %}
            <div class="card">
                <h3 style="color: #38bdf8; margin-bottom: 0.5rem;">{{ film.title }}</h3>
                <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 1rem;">
                    📅 {{ film.releaseYear }}
                </p>
                
                {% if film.synopsis %}
                    <p style="margin-bottom: 1rem; color: #cbd5e1;">
                        {{ film.synopsis|length > 150 ? film.synopsis|slice(0, 150) ~ '...' : film.synopsis }}
                    </p>
                {% endif %}

                {% if film.platformes|length > 0 %}
                    <div style="margin-bottom: 1rem;">
                        <p style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 0.5rem;">
                            <strong>Disponible sur :</strong>
                        </p>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                            {% for platforme in film.platformes %}
                                <span style="background: #0f172a; padding: 0.25rem 0.75rem; border-radius: 0.25rem; font-size: 0.85rem; color: #38bdf8;">
                                    {{ platforme.name }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <a href="{{ path('app_film_show', {id: film.id}) }}" class="btn">Voir les détails</a>
            </div>
        {% else %}
            <p style="color: #94a3b8;">
                {% if search or selectedYear or selectedPlatforme %}
                    Aucun film ne correspond à vos critères.
                {% else %}
                    Aucun film disponible pour le moment.
                {% endif %}
            </p>
        {% endfor %}
    </div>

    {# Pagination #}
    <div style="display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap;">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>

<style>
    .pagination {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
    }
    
    .pagination a,
    .pagination span {
        padding: 0.5rem 1rem;
        background: rgba(30, 41, 59, 0.6);
        color: #cbd5e1;
        text-decoration: none;
        border-radius: 0.5rem;
        border: 1px solid rgba(56, 189, 248, 0.1);
        transition: all 0.3s ease;
    }
    
    .pagination a:hover {
        background: rgba(56, 189, 248, 0.2);
        border-color: rgba(56, 189, 248, 0.3);
        color: #38bdf8;
    }
    
    .pagination .current {
        background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
        color: #0f172a;
        font-weight: 600;
        border-color: transparent;
    }
    
    @media (max-width: 768px) {
        form > div {
            grid-template-columns: 1fr !important;
        }
    }
</style>
{% endblock %}